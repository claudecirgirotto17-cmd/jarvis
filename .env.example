# Copie este arquivo para .env e preencha.

# Pasta que o Claude Code abre (seu segundo cérebro, vault ou projeto)
JARVIS_PASTA=~/Documentos/meu-vault

# ElevenLabs: voz da resposta (e transcrição, se você não tiver whisper local)
ELEVENLABS_API_KEY=
# ID da voz. Escolha na Voice Library, clique em "Add to my voices" e copie o ID.
JARVIS_VOZ=xHUwLsLfyqiYOIVTzLRW
# eleven_multilingual_v2 = melhor som | eleven_flash_v2_5 = começa a falar mais rápido
JARVIS_MODELO_VOZ=eleven_multilingual_v2
# Velocidade da fala: 1.0 normal (de 0.7 a 1.2)
JARVIS_VELOCIDADE_VOZ=1.0

# Provedor da voz: vem da voz escolhida (campo "provedor" do vozes.json). Pra usar outra voz, coloque o "id" dela
# em JARVIS_VOZ (ex.: openai-onyx, google-neural2-b, local). Chaves dos outros provedores:
OPENAI_API_KEY=
# tts-1 ou tts-1-hd (aceitam velocidade) | gpt-4o-mini-tts (sem velocidade)
JARVIS_OPENAI_MODELO_VOZ=tts-1
GOOGLE_API_KEY=
# Voz local, sem internet: comando que lê o texto na entrada padrão e grava o áudio em {saida} (precisa do ffmpeg)
# Ex. com Piper: piper --model ~/vozes/pt_BR-faber-medium.onnx --output_file {saida}
JARVIS_VOZ_COMANDO=

# Transcrição: auto (tenta o whisper local e cai pro ElevenLabs) | whisper | elevenlabs | openai | deepgram | google
JARVIS_TRANSCRICAO=auto
WHISPER_URL=http://127.0.0.1:8178
# openai usa OPENAI_API_KEY (modelo whisper-1 ou gpt-4o-transcribe); deepgram usa a chave abaixo; google usa GOOGLE_API_KEY
JARVIS_OPENAI_MODELO_STT=whisper-1
DEEPGRAM_API_KEY=
JARVIS_DEEPGRAM_MODELO=nova-2

# Cérebro: claude (Claude Code, com ferramentas e a trava) | chat (qualquer API compatível com a da OpenAI:
# OpenAI, Ollama, LM Studio, Groq, OpenRouter. Só conversa, sem ferramentas)
JARVIS_CEREBRO=claude
# Só no modo chat. Ollama: http://localhost:11434/v1 (a chave pode ficar vazia)
JARVIS_CEREBRO_URL=https://api.openai.com/v1
JARVIS_CEREBRO_MODELO=gpt-4o-mini
JARVIS_CEREBRO_CHAVE=
# Só no modo claude: Claude Code atrás de um gateway compatível (LiteLLM, OpenRouter...). Deixe vazio pro padrão.
JARVIS_CLAUDE_URL=
JARVIS_CLAUDE_CHAVE=

# Modelo do Claude: sonnet (mais rápido) | opus (mais caprichado)
JARVIS_MODELO=sonnet
# Quanto ele pensa antes de agir: low (mais rápido) | medium | high
JARVIS_ESFORCO=low
# leve = abre numa pasta vazia com a sua pasta anexada (responde em ~1 s) | completo = abre direto na sua pasta (carrega o CLAUDE.md dela; bom pra pasta pequena)
JARVIS_CONTEXTO=leve
# Arquivo de persona (troque pra ter um modo diferente, ex.: persona-video.md)
JARVIS_PERSONA=persona.md

# Ferramentas que o JARVIS não pode usar (separadas por vírgula)
JARVIS_BLOQUEAR_FERRAMENTAS=

# Atalhos lentos que rodam quando ele abre (separe por ;). Ex.: isca_resumo.py --dia ontem
JARVIS_AQUECER_ATALHOS=

JARVIS_PORTA=8790
